{
  "name": "leslies-notes-on-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate:content && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:content": "node scripts/validate-content.mjs",
    "review:stale": "node scripts/review-notes.mjs",
    "check": "npm run test && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "github-slugger": "latest",
    "gray-matter": "latest",
    "katex": "^0.18.4",
    "mdast-util-to-string": "latest",
    "next": "^16.3.1",
    "react": "latest",
    "react-dom": "latest",
    "reading-time": "latest",
    "rehype-autolink-headings": "latest",
    "rehype-katex": "latest",
    "rehype-sanitize": "latest",
    "rehype-slug": "latest",
    "rehype-stringify": "latest",
    "remark-gfm": "latest",
    "remark-math": "latest",
    "remark-parse": "latest",
    "remark-rehype": "latest",
    "server-only": "latest",
    "unified": "latest",
    "unist-util-visit": "latest"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "latest",
    "eslint-config-next": "^16.3.1",
    "typescript": "6.0.3",
    "vitest": "latest"
  },
  "overrides": {
    "minimatch": "10.2.6",
    "brace-expansion": "5.0.9",
    "js-yaml": "4.3.1",
    "gray-matter": {
      "js-yaml": "3.15.1"
    },
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
